# ─── Firebase client SDK ───────────────────────────────────────────────────────
# All NEXT_PUBLIC_ vars are bundled into the client. Get these from:
# Firebase Console → Project Settings → Your apps → Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Anthropic ─────────────────────────────────────────────────────────────────
# Server-side only — never expose to the client.
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─── Firebase Admin SDK ────────────────────────────────────────────────────────
# Server-side only — used by /api/reflect to read Firestore and verify Auth tokens.
# Generate from: Firebase Console → Project Settings → Service accounts →
#   "Generate new private key" → download JSON → minify → paste here.
# Leave empty in local development when using the emulator.
FIREBASE_ADMIN_SERVICE_ACCOUNT=

# ─── Local development (emulator) ──────────────────────────────────────────────
# Set NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true to route all Firebase calls to the
# local emulator instead of the live project.  Remove / set to false in production.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080

# ─── Local dev workflow ─────────────────────────────────────────────────────────
# Terminal 1:  npm run emulate   (start Firebase emulator)
# Terminal 2:  npm run dev       (start Next.js)
# One-time:    npm run seed      (populate Firestore with sample questions)
